{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "types": ["node"],
    // DOM entra por causa do preload: ele roda no contexto do renderer e usa
    // `window`, `EventListener` e afins. Sem isto, o typecheck do lado node
    // acusava "Cannot find name 'window'" em código correto.
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*.ts"
  ]
}
