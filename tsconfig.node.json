{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "types": ["node"],
    // DOM entra por causa do preload: ele roda no contexto do renderer e usa
    // `window`, `EventListener` e afins. Sem isto, o typecheck do lado node
    // acusava "Cannot find name 'window'" em código correto.
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*.ts",
    // O main importa tipos compartilhados de `src/types` (ex.: operations.ts,
    // usado por electron/main/services/operations.ts). Sem listar esta pasta,
    // o typecheck do lado node falha com TS6307 — "file is not listed within
    // the file list of project" — num import que está correto.
    "src/types/**/*.ts"
  ]
}
